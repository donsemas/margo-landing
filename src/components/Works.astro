---
import { works } from '../data/content';
---
<section class="works section" id="works">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Портфолио</span>
      <h2 class="section-title">Избранные <em>проекты</em></h2>
    </div>
    <div class="works-list">
      {works.map((work) => (
        <a href={`/works/${work.slug}`} class="work-item reveal" aria-label={`${work.title} — подробнее`}>
          <div class="work-meta">
            <span class="work-num">{work.num}</span>
            <span class="work-tag">{work.tag}</span>
          </div>
          <div class="work-body">
            <h3>{work.title}</h3>
            <p>{work.text}</p>
          </div>
          <div class="work-result">
            <span class="result-value work-type-value">{work.type}</span>
            <span class="result-label">формат работы</span>
          </div>
          <svg class="work-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>
